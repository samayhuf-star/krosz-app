{
  "name": "Slack Application Alert",
  "description": "Posts a Slack alert to #all-krosz whenever a new visa application is created.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "VisaApplication",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.destination != null and .trigger.data.destination != \"\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "slack_application_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "post_alert": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "slackApplicationAlert",
            "args": {
              "application_id": "${ .trigger.entity_id }",
              "destination": "${ .trigger.data.destination }",
              "purpose": "${ .trigger.data.purpose }",
              "case_state": "${ .trigger.data.case_state }",
              "traveler_id": "${ .trigger.data.traveler_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Post Slack alert",
            "description": "New application \u2192 #all-krosz"
          }
        }
      }
    ]
  }
}
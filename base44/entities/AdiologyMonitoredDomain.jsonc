{
  "name": "AdiologyMonitoredDomain",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "registrar": {
      "type": "string"
    },
    "expiryDate": {
      "type": "string",
      "format": "date-time"
    },
    "createdDate": {
      "type": "string",
      "format": "date-time"
    },
    "updatedDate": {
      "type": "string",
      "format": "date-time"
    },
    "nameServers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "whoisData": {
      "type": "object"
    },
    "sslIssuer": {
      "type": "string"
    },
    "sslExpiryDate": {
      "type": "string",
      "format": "date-time"
    },
    "sslValidFrom": {
      "type": "string",
      "format": "date-time"
    },
    "sslData": {
      "type": "object"
    },
    "dnsRecords": {
      "type": "object"
    },
    "lastCheckedAt": {
      "type": "string",
      "format": "date-time"
    },
    "alertDays": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "alertsEnabled": {
      "type": "boolean",
      "default": true
    },
    "alertEmail": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "active"
    }
  },
  "required": [
    "domain"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
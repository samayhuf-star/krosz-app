{
  "name": "PhoneNumber",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "number": {
      "type": "string"
    },
    "number_type": {
      "type": "string",
      "enum": [
        "local",
        "toll_free"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "pending",
        "active",
        "released"
      ],
      "default": "planned"
    },
    "external_reference": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "number_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
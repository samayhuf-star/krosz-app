{
  "name": "DerivedSubmissionArtifact",
  "type": "object",
  "description": "Worldz Visa (Phase 11): a derived/transcoded file produced from an immutable DocumentVersion when a portal requires a specific format (\u00a715). The original DocumentVersion is NEVER mutated. The artifact is uploaded to the portal; provenance (source version + hash) is stored. Owner-of-application-or-admin; system/admin create.",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "application_id": {
      "type": "string",
      "description": "Denormalized."
    },
    "traveler_id": {
      "type": "string",
      "description": "Denormalized for access checks."
    },
    "source_document_version_id": {
      "type": "string"
    },
    "source_document_id": {
      "type": "string",
      "description": "Denormalized."
    },
    "portal_definition_id": {
      "type": "string"
    },
    "document_type": {
      "type": "string"
    },
    "portal_format": {
      "type": "string",
      "description": "e.g. application/pdf, image/jpeg."
    },
    "storage_uri": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "file_size": {
      "type": "number"
    },
    "derived_from_hash": {
      "type": "string",
      "description": "Hash of the source version content for provenance/integrity."
    },
    "created_for_upload": {
      "type": "boolean",
      "default": true
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "traveler_id",
    "source_document_version_id",
    "document_type",
    "portal_format",
    "storage_uri",
    "mime_type",
    "file_size"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "AdiologyCampaignVersion",
  "type": "object",
  "description": "Immutable-ish version snapshot of a workspace campaign for audit, rollback, comparison and AI explainability.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "version": {
      "type": "number"
    },
    "snapshot": {
      "type": "object"
    },
    "change_summary": {
      "type": "string"
    },
    "changed_by": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "ai",
        "import",
        "sync",
        "publish"
      ],
      "default": "manual"
    },
    "correlation_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "workspace_id",
    "campaign_id",
    "version",
    "snapshot",
    "created_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "OperationsTask",
  "type": "object",
  "description": "Worldz Visa (Phase 32): a discrete operational work item in the Operations Queue. ONE row per (case_id, task_type, source_event) unit of work. This is a WORK-MANAGEMENT layer \u2014 it does NOT own application case state (the Phase 27/31 Case Engine remains the sole authority). Multiple tasks may exist per case across its lifetime; each belongs to a single queue and follows a simple work-state model (QUEUED \u2192 ASSIGNED \u2192 IN_PROGRESS \u2192 WAITING/BLOCKED \u2192 COMPLETED/CANCELLED). Tasks are generated deterministically from CaseEvents by the task rule resolver \u2014 never by an LLM and never created by the frontend. Internal-only: admin/operations access; travelers have no access. Denormalized case fields (destination/journey_type/nationality/provider_key/execution_capability) are filter indexes projected from the case \u2014 NOT a second source of truth. Phase 32 adds intelligence-change revalidation task types (\u00a75). Phase 38 adds production-ops task types (PROVIDER_SLA_WARNING/BREACH, FINANCIAL_RECONCILIATION, PROVIDER_EXCEPTION, CHARGEBACK_REVIEW, PAYMENT_EXCEPTION) generated by the SLA timer, reconciliation mismatch, provider failure, chargeback, and anomaly detectors (\u00a719).",
  "properties": {
    "case_id": {
      "type": "string",
      "description": "VisaApplication.id this task belongs to."
    },
    "application_id": {
      "type": "string",
      "description": "Denormalized for fast filtering (== case_id)."
    },
    "traveler_id": {
      "type": "string",
      "description": "Denormalized."
    },
    "organization_id": {
      "type": "string"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "ELIGIBILITY_REVIEW",
        "DOCUMENT_REVIEW",
        "DOCUMENT_REQUEST",
        "CASE_REVIEW",
        "PAYMENT_REVIEW",
        "SUBMISSION_REVIEW",
        "PROVIDER_SUBMISSION",
        "PROVIDER_STATUS_CHECK",
        "ADDITIONAL_INFORMATION",
        "TRAVELER_CONTACT",
        "MANUAL_PROCESSING",
        "EXCEPTION_HANDLING",
        "REFUND_REVIEW",
        "COMPLIANCE_REVIEW",
        "INTELLIGENCE_REVIEW",
        "DOCUMENT_RECHECK",
        "APPLICATION_REVALIDATION",
        "PROVIDER_ROUTE_REVIEW",
        "FORM_MAPPING_REVIEW",
        "PROVIDER_SLA_WARNING",
        "PROVIDER_SLA_BREACH",
        "FINANCIAL_RECONCILIATION",
        "PROVIDER_EXCEPTION",
        "CHARGEBACK_REVIEW",
        "PAYMENT_EXCEPTION"
      ],
      "description": "Deterministic task type (\u00a75). Reused, no variants. Phase 37 adds intelligence-change revalidation types. Phase 38 adds production-ops types (\u00a719)."
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "queue": {
      "type": "string",
      "enum": [
        "DOCUMENTS",
        "REVIEW",
        "SUBMISSION",
        "PROVIDER",
        "ADDITIONAL_INFORMATION",
        "PAYMENTS",
        "EXCEPTIONS",
        "MANUAL_PROCESSING"
      ],
      "description": "Primary operational queue (\u00a79)."
    },
    "priority": {
      "type": "string",
      "enum": [
        "LOW",
        "NORMAL",
        "HIGH",
        "URGENT"
      ],
      "default": "NORMAL"
    },
    "status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "ASSIGNED",
        "IN_PROGRESS",
        "WAITING",
        "BLOCKED",
        "COMPLETED",
        "CANCELLED"
      ],
      "default": "QUEUED",
      "description": "Work-state model (\u00a74). Intentionally distinct from case_state."
    },
    "assigned_to": {
      "type": "string",
      "description": "Operations user assigned; null = UNASSIGNED."
    },
    "assigned_team": {
      "type": "string",
      "description": "Auto-assigned team from the deterministic assignment map (\u00a712)."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "due_at": {
      "type": "string",
      "format": "date-time",
      "description": "Operational SLA due date (\u00a711). NOT a government visa deadline."
    },
    "waiting_since": {
      "type": "string",
      "format": "date-time"
    },
    "waiting_reason": {
      "type": "string",
      "description": "WAITING_FOR_TRAVELER | WAITING_FOR_PROVIDER | WAITING_FOR_PAYMENT | WAITING_FOR_GOVERNMENT | other."
    },
    "next_check_at": {
      "type": "string",
      "format": "date-time"
    },
    "blocked_at": {
      "type": "string",
      "format": "date-time"
    },
    "block_reason": {
      "type": "string"
    },
    "blocker_owner": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_by": {
      "type": "string"
    },
    "source_event_id": {
      "type": "string",
      "description": "CaseEvent id that generated this task (\u00a76/\u00a77)."
    },
    "source_rule": {
      "type": "string",
      "description": "Deterministic rule key that generated this task."
    },
    "idempotency_key": {
      "type": "string",
      "description": "Stable dedup key (case_id + source_event_id + task_type). The same CaseEvent never creates duplicate work (\u00a77)."
    },
    "resolution": {
      "type": "object",
      "description": "Structured resolution (\u00a721). { decision, reason, at, by }. Decision-bearing tasks require an allowed decision \u2014 no generic 'Done'."
    },
    "priority_override": {
      "type": "object",
      "description": "Recorded admin priority override (\u00a710). { actor, reason, at }. Presence = audited override."
    },
    "sla_policy": {
      "type": "object",
      "description": "Operational SLA policy snapshot (\u00a711). { hours, label }. Never a government guarantee."
    },
    "automation_class": {
      "type": "string",
      "enum": [
        "MANUAL",
        "ASSISTED",
        "AUTOMATABLE",
        "AUTOMATED"
      ],
      "default": "MANUAL",
      "description": "Phase 32 classification only (\u00a729). Autonomous execution is NOT activated in this phase."
    },
    "exception_id": {
      "type": "string",
      "description": "Linked CaseException, if generated from/for this task (\u00a726)."
    },
    "destination": {
      "type": "string",
      "description": "Denormalized case destination for server-side filtering only."
    },
    "journey_type": {
      "type": "string",
      "description": "Denormalized case journey for server-side filtering only."
    },
    "nationality": {
      "type": "string",
      "description": "Denormalized case nationality for server-side filtering only (admin-visible)."
    },
    "provider_key": {
      "type": "string",
      "description": "Denormalized case provider for server-side filtering only."
    },
    "execution_capability": {
      "type": "string",
      "description": "Denormalized case execution capability for server-side filtering only."
    },
    "metadata": {
      "type": "object"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "case_id",
    "task_type",
    "queue",
    "priority",
    "status",
    "idempotency_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
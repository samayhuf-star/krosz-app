{
  "name": "EmailThread",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "mailbox_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "snippet": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "participant_count": {
      "type": "number",
      "default": 0
    },
    "message_count": {
      "type": "number",
      "default": 0
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "assigned_user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "pending",
        "awaiting_customer",
        "resolved",
        "snoozed"
      ],
      "default": "open"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "crm_link": {
      "type": "string",
      "description": "Lead/Contact id linked to this conversation."
    },
    "ticket_link": {
      "type": "string",
      "description": "Support Ticket id linked to this conversation."
    },
    "kg_link": {
      "type": "string",
      "description": "Knowledge Graph node id (provenance trail)."
    },
    "internal_notes_count": {
      "type": "number",
      "default": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "subject",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "InterviewEvent",
  "type": "object",
  "description": "Worldz Visa (Phase 9): operational metadata for an interview appointment. Stores status + outcome + a notes DOCUMENT reference (notes themselves live in the Document Vault). An AI visa decision is NEVER derived from interview notes. Owner-of-appointment-or-admin (application_id + traveler_id denormalized).",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "appointment_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string",
      "description": "Denormalized for access checks."
    },
    "traveler_id": {
      "type": "string",
      "description": "Denormalized for access checks."
    },
    "status": {
      "type": "string",
      "enum": [
        "REQUIRED",
        "SCHEDULED",
        "COMPLETED",
        "FAILED",
        "WAIVED"
      ],
      "default": "REQUIRED"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "type": "string",
      "description": "Operator-recorded outcome label (e.g. approved_flagged, additional_info)."
    },
    "notes_reference": {
      "type": "string",
      "description": "Document id/version of uploaded interview notes (content not stored here)."
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "appointment_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "CRMActivity",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "contact_id": {
      "type": "string"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "note",
        "task",
        "call",
        "email",
        "meeting",
        "status_change",
        "follow_up"
      ]
    },
    "title": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "assigned_user_id": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "activity_type",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "CRMProject",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "blueprint_id": {
      "type": "string"
    },
    "blueprint_version": {
      "type": "number"
    },
    "website_id": {
      "type": "string"
    },
    "website_version": {
      "type": "number"
    },
    "seo_project_id": {
      "type": "string"
    },
    "seo_version_id": {
      "type": "string"
    },
    "seo_version": {
      "type": "number"
    },
    "name": {
      "type": "string"
    },
    "current_version": {
      "type": "number"
    },
    "active_crm_version_id": {
      "type": "string"
    },
    "health_score": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "archived"
      ],
      "default": "active"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "seo_version_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
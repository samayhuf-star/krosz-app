{
  "name": "ApplicationDocument",
  "type": "object",
  "description": "Worldz Visa (Phase 4): the pinned relationship between a VisaApplication, a reusable Document, and the exact DocumentVersion used. Pinned versions give auditability \u2014 uploading a new version never silently changes an in-flight application. Owner-of-application-or-admin (created_by_id == application owner).",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "application_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "document_version_id": {
      "type": "string",
      "description": "Pinned immutable version actually submitted."
    },
    "requirement_id": {
      "type": "string",
      "description": "Optional DocumentRequirement / VisaRequirement id this satisfies."
    },
    "document_type": {
      "type": "string"
    },
    "is_required": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "attached",
        "used",
        "verified",
        "rejected",
        "detached"
      ],
      "default": "attached"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "application_id",
    "document_id",
    "document_version_id",
    "document_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
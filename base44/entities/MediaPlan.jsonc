{
  "name": "MediaPlan",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "website_id": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "page_id": {
      "type": "string"
    },
    "page_slug": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "component_key": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "hero",
        "gallery",
        "icon",
        "illustration",
        "logo",
        "background"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "aspect_ratio": {
      "type": "string"
    },
    "image_prompt": {
      "type": "string"
    },
    "alt_text": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "website_id",
    "media_type",
    "image_prompt"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
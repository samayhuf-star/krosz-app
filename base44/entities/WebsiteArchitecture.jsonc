{
  "name": "WebsiteArchitecture",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "website_id": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "name": {
      "type": "string"
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "footer": {
      "type": "object"
    },
    "primary_cta": {
      "type": "string"
    },
    "secondary_cta": {
      "type": "string"
    },
    "brand_theme": {
      "type": "object"
    },
    "color_palette": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "typography": {
      "type": "object"
    },
    "spacing": {
      "type": "string"
    },
    "grid_system": {
      "type": "string"
    },
    "icon_style": {
      "type": "string"
    },
    "image_style": {
      "type": "string"
    },
    "animation_style": {
      "type": "string"
    },
    "component_library": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "design_tokens": {
      "type": "object"
    },
    "responsive_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accessibility_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "website_id",
    "version",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
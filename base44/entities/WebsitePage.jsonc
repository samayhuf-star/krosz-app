{
  "name": "WebsitePage",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "website_id": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "audience": {
      "type": "string"
    },
    "primary_cta": {
      "type": "string"
    },
    "seo_intent": {
      "type": "string"
    },
    "parent": {
      "type": "string"
    },
    "children": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "number"
    },
    "template": {
      "type": "string"
    },
    "seo": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "website_id",
    "slug",
    "title",
    "template"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
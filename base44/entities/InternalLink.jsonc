{
  "name": "InternalLink",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "seo_project_id": {
      "type": "string"
    },
    "seo_version_id": {
      "type": "string"
    },
    "source_page_id": {
      "type": "string"
    },
    "source_page_slug": {
      "type": "string"
    },
    "target_page_id": {
      "type": "string"
    },
    "target_page_slug": {
      "type": "string"
    },
    "anchor_text": {
      "type": "string"
    },
    "link_type": {
      "type": "string",
      "enum": [
        "contextual",
        "nav",
        "breadcrumb",
        "related"
      ],
      "default": "contextual"
    },
    "status": {
      "type": "string",
      "enum": [
        "recommended",
        "applied",
        "broken"
      ],
      "default": "recommended"
    },
    "priority": {
      "type": "number",
      "default": 50
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "seo_project_id",
    "seo_version_id",
    "source_page_slug",
    "target_page_slug"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
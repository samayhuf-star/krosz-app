{
  "name": "IntegrationConnector",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "definition_key": {
      "type": "string",
      "description": "Connector catalog key (e.g. shopify, stripe, custom_webhook)."
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "unconfigured",
        "connecting",
        "connected",
        "error",
        "disabled"
      ],
      "default": "unconfigured"
    },
    "auth": {
      "type": "object",
      "description": "Authentication state. Secrets are never stored here \u2014 only references and scopes.",
      "properties": {
        "type": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "not_started",
            "pending",
            "connected",
            "expired",
            "error"
          ],
          "default": "not_started"
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "connected_account_id": {
          "type": "string"
        },
        "connected_user_id": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "health": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "healthy",
            "degraded",
            "down",
            "unknown"
          ],
          "default": "unknown"
        },
        "last_checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_error": {
          "type": "string"
        },
        "consecutive_failures": {
          "type": "number",
          "default": 0
        }
      }
    },
    "sync": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "manual",
            "scheduled",
            "webhook",
            "incremental"
          ],
          "default": "manual"
        },
        "schedule_cron": {
          "type": "string"
        },
        "last_sync_at": {
          "type": "string",
          "format": "date-time"
        },
        "next_sync_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_run_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "idle",
            "running",
            "error",
            "paused"
          ],
          "default": "idle"
        },
        "resume_cursor": {
          "type": "string"
        }
      }
    },
    "rate_limits": {
      "type": "object",
      "properties": {
        "remaining": {
          "type": "number"
        },
        "reset_at": {
          "type": "string",
          "format": "date-time"
        },
        "limit": {
          "type": "number"
        },
        "window": {
          "type": "string"
        }
      }
    },
    "retry_policy": {
      "type": "object",
      "properties": {
        "max_retries": {
          "type": "number",
          "default": 3
        },
        "backoff_ms": {
          "type": "number",
          "default": 1000
        },
        "fallback_enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supported_objects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permission_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "description": "Provider-specific NON-secret configuration (endpoints, mappings, event_workflows). Secrets live in Base44 secrets or OAuth tokens."
    },
    "webhook_secret": {
      "type": "string",
      "description": "Shared secret used to verify inbound webhooks for this connector."
    },
    "last_webhook_at": {
      "type": "string",
      "format": "date-time"
    },
    "installed_by": {
      "type": "string"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "definition_key",
    "name",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "Application",
  "type": "object",
  "description": "ORCHESTRAL CORE \u2014 the first-class boundary a consumer (another app or AI agent) registers to use Orchestral. Organization -> Project -> Application -> Runs -> Tasks. An Application MAY link to an existing Business (legacy launch app) via business_id, but Orchestral itself is domain-agnostic: a Run only needs an Application + a PlanTemplate.",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "tenant_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe unique identifier within the Project."
    },
    "kind": {
      "type": "string",
      "enum": [
        "business_launch",
        "custom",
        "agent_team",
        "external_agent"
      ],
      "default": "custom",
      "description": "Hints the default PlanTemplate / agent set; not used to branch engine logic."
    },
    "business_id": {
      "type": "string",
      "description": "Optional link to a Business record (the legacy launch domain). NULL for pure-orchestration applications. Lets the existing Website/SEO/CRM factories keep operating through the same engine without Orchestral depending on them."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "archived"
      ],
      "default": "active"
    },
    "default_plan_template_id": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "description": "Application-level overrides: provider bindings, approval policy, telemetry sampling, capability allow-list."
    }
  },
  "required": [
    "tenant_id",
    "organization_id",
    "project_id",
    "name",
    "slug"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "HelpFaq",
  "type": "object",
  "description": "Krosz Help Center (Phase 2): a frequently asked question shown to travelers. Public read so anonymous visitors can browse/search; admin-managed writes. keywords[] is an optional list of extra search terms; order drives display ordering within a category.",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "getting-started",
        "eligibility",
        "documents",
        "applications",
        "payments",
        "refunds",
        "appointments",
        "status",
        "account",
        "support",
        "trust"
      ],
      "default": "getting-started"
    },
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "order": {
      "type": "number",
      "default": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "published"
    }
  },
  "required": [
    "category",
    "question",
    "answer",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
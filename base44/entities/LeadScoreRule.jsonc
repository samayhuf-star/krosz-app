{
  "name": "LeadScoreRule",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "crm_project_id": {
      "type": "string"
    },
    "crm_version_id": {
      "type": "string"
    },
    "crm_version": {
      "type": "number"
    },
    "seo_version_id": {
      "type": "string"
    },
    "website_id": {
      "type": "string"
    },
    "blueprint_id": {
      "type": "string"
    },
    "blueprint_version": {
      "type": "number"
    },
    "rule_key": {
      "type": "string"
    },
    "field": {
      "type": "string"
    },
    "operator": {
      "type": "string",
      "enum": [
        "equals",
        "not_equals",
        "greater_than",
        "less_than",
        "contains",
        "in_services",
        "in_location",
        "source_is",
        "intent_is"
      ]
    },
    "value": {
      "type": "string"
    },
    "points": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "priority": {
      "type": "number"
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "crm_project_id",
    "crm_version_id",
    "rule_key",
    "field",
    "operator"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
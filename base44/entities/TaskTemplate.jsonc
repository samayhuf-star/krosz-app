{
  "name": "TaskTemplate",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "crm_project_id": {
      "type": "string"
    },
    "crm_version_id": {
      "type": "string"
    },
    "crm_version": {
      "type": "number"
    },
    "seo_version_id": {
      "type": "string"
    },
    "website_id": {
      "type": "string"
    },
    "blueprint_id": {
      "type": "string"
    },
    "blueprint_version": {
      "type": "number"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "daily",
        "follow_up",
        "call",
        "meeting",
        "renewal",
        "reminder",
        "escalation",
        "review_request"
      ]
    },
    "trigger": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "due_offset_hours": {
      "type": "number"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "description": {
      "type": "string"
    },
    "escalation_hours": {
      "type": "number"
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "crm_project_id",
    "crm_version_id",
    "name",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
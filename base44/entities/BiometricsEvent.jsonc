{
  "name": "BiometricsEvent",
  "type": "object",
  "description": "Worldz Visa (Phase 9): operational metadata for a biometrics appointment. Stores ONLY operational state (status, completion, provider reference) \u2014 never biometric data itself. Owner-of-appointment-or-admin (application_id + traveler_id denormalized).",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "appointment_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string",
      "description": "Denormalized for access checks."
    },
    "traveler_id": {
      "type": "string",
      "description": "Denormalized for access checks."
    },
    "status": {
      "type": "string",
      "enum": [
        "REQUIRED",
        "SCHEDULED",
        "COMPLETED",
        "FAILED",
        "WAIVED"
      ],
      "default": "REQUIRED"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_reference": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "description": "Operational metadata only (no biometric data)."
    }
  },
  "required": [
    "appointment_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
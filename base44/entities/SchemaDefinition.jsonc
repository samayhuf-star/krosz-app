{
  "name": "SchemaDefinition",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "seo_project_id": {
      "type": "string"
    },
    "seo_version_id": {
      "type": "string"
    },
    "page_id": {
      "type": "string"
    },
    "page_slug": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "global",
        "page"
      ],
      "default": "page"
    },
    "schema_type": {
      "type": "string",
      "enum": [
        "Organization",
        "LocalBusiness",
        "Service",
        "FAQ",
        "Review",
        "Article",
        "Breadcrumb",
        "Person",
        "Product",
        "Video",
        "Event"
      ]
    },
    "schema_data": {
      "type": "object"
    },
    "relevance": {
      "type": "string"
    },
    "applied": {
      "type": "boolean",
      "default": false
    },
    "priority": {
      "type": "number"
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "seo_project_id",
    "seo_version_id",
    "schema_type",
    "schema_data"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
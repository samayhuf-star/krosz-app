{
  "name": "AgentTeam",
  "type": "object",
  "description": "A versioned, immutable-when-used Agent Team definition: a controlled execution group of specialized agents run inside a SINGLE LaunchTask (task type run_agent_team). The team is NOT a second workflow engine \u2014 the Workflow Engine still owns task ordering, retries, approvals and DAG state; the team adapter only runs its internal agent graph within the one dispatched task and reuses the Agent Runtime, Provider Runtime, Tool Registry, AIExecution, BusinessMemory and Langfuse.",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string",
      "description": "Logical team id, e.g. website_intelligence. Stable across versions."
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Version number. New edits fork a new version row; the prior active version becomes 'superseded'. A run pins (team_id, version) so the execution is immutable."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "superseded",
        "archived"
      ],
      "default": "draft",
      "description": "Only one 'active' version per (tenant, business, team_id) at a time."
    },
    "agents": {
      "type": "array",
      "description": "The specialized agents in the team. Each references a real AIAgent record (by agent_id) and narrows its tools to allowed_tools (effective permission = intersection; team can never exceed the agent's own permission).",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Stable key within the team, used by depends_on and the entry_agent."
          },
          "role": {
            "type": "string"
          },
          "agent_id": {
            "type": "string"
          },
          "agent_purpose": {
            "type": "string",
            "description": "Optional standard-agent purpose for auto-seeding the backing AIAgent."
          },
          "allowed_tools": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Subset of the agent's own config.tools. Effective tools = this list, validated to be a subset."
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Other agent keys whose structured outputs this agent may receive. Empty = entry/root agent."
          },
          "model": {
            "type": "string"
          },
          "instructions_override": {
            "type": "string"
          },
          "output_schema": {
            "type": "object",
            "description": "Must include answer/tool_used/result_summary plus this agent's domain fields."
          }
        }
      }
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "sequential",
        "parallel",
        "dependent"
      ],
      "default": "dependent",
      "description": "Informational. The runtime uses declared depends_on to order agents (sequential = chain; parallel = independent fan-out; dependent = mixed DAG)."
    },
    "entry_agent": {
      "type": "string"
    },
    "output_schema": {
      "type": "object",
      "description": "Final team output JSON schema; validated before success."
    },
    "timeout_ms": {
      "type": "number",
      "default": 120000
    },
    "max_total_iterations": {
      "type": "number",
      "default": 20
    },
    "max_total_tool_calls": {
      "type": "number",
      "default": 30
    },
    "budget_limit": {
      "type": "number",
      "default": 0,
      "description": "0 = unlimited. Cumulative estimated_cost across agents."
    },
    "approval_required": {
      "type": "boolean",
      "default": false,
      "description": "If true, the PlanTemplate should gate the run_agent_team task with an approval_gate. The engine owns the gate; the team never self-approves."
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "config_hash": {
      "type": "string",
      "description": "Hash of the team definition at publish time. A run pins it and the adapter verifies it on load (immutability)."
    },
    "created_by": {
      "type": "string"
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "stats": {
      "type": "object",
      "description": "Cached aggregate stats computed from run_agent_team LaunchTasks for this team_id. Non-authoritative.",
      "properties": {
        "runs": {
          "type": "number"
        },
        "successes": {
          "type": "number"
        },
        "success_rate": {
          "type": "number"
        },
        "total_cost": {
          "type": "number"
        },
        "avg_duration_ms": {
          "type": "number"
        },
        "last_run_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "team_id",
    "name",
    "version",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "ApplicationFormSnapshot",
  "type": "object",
  "description": "Worldz Visa (Phase 7): an immutable generated government form for an application, pinned to a form_definition + version. data_hash (SHA-256) over fields+trace+documents. dependency_fingerprint tracks source question_codes + their value hashes so staleness is deterministic. status: fresh | stale | superseded. Owner-of-application-or-admin.",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "application_id": {
      "type": "string"
    },
    "traveler_id": {
      "type": "string",
      "description": "Denormalized for access checks."
    },
    "form_definition_id": {
      "type": "string"
    },
    "form_code": {
      "type": "string",
      "description": "Denormalized."
    },
    "form_version": {
      "type": "string",
      "description": "Denormalized form definition version at generation time."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "data_hash": {
      "type": "string"
    },
    "dependency_fingerprint": {
      "type": "object",
      "description": "{ field_code: { sources: [question_code...], hash: '...' } }."
    },
    "fields": {
      "type": "object",
      "description": "Generated government field values keyed by field_code."
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Per-field trace: [{ government_field, value, source, transformation, source_field }]."
    },
    "validation": {
      "type": "object",
      "description": "Validation result captured at generation: { valid, errors }."
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Missing mappings / sources surfaced at generation."
    },
    "status": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "superseded"
      ],
      "default": "fresh"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "application_id",
    "form_definition_id",
    "form_code",
    "form_version",
    "generated_at",
    "data_hash",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
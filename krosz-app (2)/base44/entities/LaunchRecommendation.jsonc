{
  "name": "LaunchRecommendation",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "launch_id": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "seo",
        "website",
        "domain",
        "crm",
        "team",
        "automation",
        "growth",
        "support",
        "marketing",
        "other"
      ]
    },
    "priority": {
      "type": "number",
      "default": 50
    },
    "rationale": {
      "type": "string"
    },
    "action_label": {
      "type": "string"
    },
    "action_target": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "done",
        "dismissed"
      ],
      "default": "open"
    },
    "confidence": {
      "type": "number",
      "default": 0.7,
      "description": "AI confidence 0-1 that this recommendation is correct."
    },
    "expected_impact": {
      "type": "string",
      "description": "Plain-language expected business impact."
    },
    "estimated_effort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low"
    },
    "decision": {
      "type": "string",
      "enum": [
        "recommend",
        "ask_user",
        "auto_fix",
        "escalate"
      ],
      "default": "recommend"
    },
    "source_observations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Observation ids that produced this recommendation."
    },
    "auto_action": {
      "type": "string",
      "description": "If decision=auto_fix, the workflow/template the AI will dispatch."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "launch_id",
    "key",
    "title",
    "category",
    "priority"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "DashboardWidget",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "crm_project_id": {
      "type": "string"
    },
    "crm_version_id": {
      "type": "string"
    },
    "crm_version": {
      "type": "number"
    },
    "seo_version_id": {
      "type": "string"
    },
    "website_id": {
      "type": "string"
    },
    "blueprint_id": {
      "type": "string"
    },
    "blueprint_version": {
      "type": "number"
    },
    "key": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "metric": {
      "type": "string",
      "enum": [
        "new_leads",
        "qualified_leads",
        "pipeline_value",
        "conversion_rate",
        "tasks_due",
        "upcoming_meetings",
        "recent_activity",
        "lead_sources",
        "top_services",
        "stage_distribution"
      ]
    },
    "data_source": {
      "type": "string"
    },
    "size": {
      "type": "string",
      "enum": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md"
    },
    "order": {
      "type": "number"
    },
    "icon_hint": {
      "type": "string"
    },
    "config": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "crm_project_id",
    "crm_version_id",
    "key",
    "title",
    "metric"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
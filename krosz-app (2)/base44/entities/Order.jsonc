{
  "name": "Order",
  "type": "object",
  "description": "Worldz Visa (Phase 10): a financial order for an application's visa product. Embeds an immutable PRICE SNAPSHOT (\u00a78) + item breakdown at order time \u2014 historical orders never recalculate from the catalog. Lifecycle is INDEPENDENT of the VisaApplication (\u00a73): Order PAID vs Application IN_PROGRESS vs Payment SUCCEEDED. Owner-or-admin (traveler_id denormalized).",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "order_number": {
      "type": "string",
      "description": "Server-generated, e.g. VIS-2026-000123 (\u00a737/\u00a740). Unique."
    },
    "traveler_id": {
      "type": "string",
      "description": "Denormalized for access checks."
    },
    "application_id": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "product_code": {
      "type": "string",
      "description": "Denormalized snapshot of VisaProduct.code."
    },
    "currency": {
      "type": "string"
    },
    "subtotal_minor": {
      "type": "number"
    },
    "tax_minor": {
      "type": "number",
      "default": 0
    },
    "discount_minor": {
      "type": "number",
      "default": 0
    },
    "total_minor": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PENDING_PAYMENT",
        "PAID",
        "PARTIALLY_PAID",
        "FAILED",
        "CANCELLED",
        "REFUND_PENDING",
        "REFUNDED",
        "PARTIALLY_REFUNDED",
        "COMPLETED"
      ],
      "default": "DRAFT"
    },
    "price_snapshot": {
      "type": "object",
      "description": "Frozen price components + totals at order creation (\u00a78). Never mutated after PAID (\u00a711)."
    },
    "price_version": {
      "type": "string"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "order_number",
    "traveler_id",
    "application_id",
    "currency",
    "total_minor",
    "status",
    "price_snapshot"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
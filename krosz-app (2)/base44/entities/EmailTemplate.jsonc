{
  "name": "EmailTemplate",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1,
      "description": "Versioned; edits fork a new row, the latest is live."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "published",
        "superseded"
      ],
      "default": "published"
    },
    "key": {
      "type": "string",
      "description": "Stable logical id, e.g. email.welcome, email.quotation."
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "sales",
        "support",
        "finance",
        "marketing",
        "hr",
        "onboarding",
        "faq"
      ],
      "default": "general"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "default": "email"
    },
    "usage_count": {
      "type": "number",
      "default": 0
    },
    "owner_role": {
      "type": "string"
    },
    "is_system": {
      "type": "boolean",
      "default": false
    },
    "created_by": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "key",
    "name",
    "subject",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "EmailMailbox",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "domain_config_id": {
      "type": "string"
    },
    "provider_config_id": {
      "type": "string"
    },
    "local_part": {
      "type": "string",
      "description": "Mailbox prefix, e.g. info, support, sales."
    },
    "email_address": {
      "type": "string",
      "description": "The FROM address (local_part@domain)."
    },
    "label": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "industry": {
      "type": "string",
      "default": "standard",
      "description": "standard, dental, gym, manufacturer, hospitality, retail, legal."
    },
    "status": {
      "type": "string",
      "enum": [
        "provisioning",
        "active",
        "suspended",
        "deleted",
        "failed"
      ],
      "default": "provisioning"
    },
    "approval_state": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "custom",
        "auto"
      ],
      "default": "pending"
    },
    "ai_recommended": {
      "type": "boolean",
      "default": false
    },
    "is_shared": {
      "type": "boolean",
      "default": false,
      "description": "Shared or team inbox; multiple members see and act on it."
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quota_mb": {
      "type": "number",
      "default": 5120
    },
    "used_mb": {
      "type": "number",
      "default": 0
    },
    "has_catch_all": {
      "type": "boolean",
      "default": false
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forwarding": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "auto_reply": {
      "type": "object",
      "description": "enabled, subject, body, until."
    },
    "auth": {
      "type": "object",
      "description": "two_factor_enabled, oauth_enabled, app_password_enabled."
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "idle",
        "syncing",
        "ok",
        "error"
      ],
      "default": "idle"
    },
    "sync_error": {
      "type": "string"
    },
    "messages_count": {
      "type": "number",
      "default": 0
    },
    "unread_count": {
      "type": "number",
      "default": 0
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "email_address",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
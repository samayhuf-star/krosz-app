{
  "name": "ProviderCredential",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "provider_id": {
      "type": "string"
    },
    "credential_label": {
      "type": "string"
    },
    "api_key_secret_name": {
      "type": "string"
    },
    "api_secret_secret_name": {
      "type": "string"
    },
    "key_configured": {
      "type": "boolean",
      "default": false
    },
    "secret_configured": {
      "type": "boolean",
      "default": false
    },
    "environment": {
      "type": "string",
      "enum": [
        "sandbox",
        "production"
      ],
      "default": "sandbox"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "configured",
        "invalid",
        "revoked"
      ],
      "default": "pending"
    }
  },
  "required": [
    "provider_id",
    "credential_label"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "CRMVersion",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "crm_project_id": {
      "type": "string"
    },
    "seo_version_id": {
      "type": "string"
    },
    "seo_version": {
      "type": "number"
    },
    "website_id": {
      "type": "string"
    },
    "website_version": {
      "type": "number"
    },
    "blueprint_id": {
      "type": "string"
    },
    "blueprint_version": {
      "type": "number"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "rejected",
        "published",
        "superseded"
      ],
      "default": "draft"
    },
    "business_analysis": {
      "type": "object"
    },
    "crm_blueprint": {
      "type": "object"
    },
    "stage_count": {
      "type": "number"
    },
    "score_rule_count": {
      "type": "number"
    },
    "automation_count": {
      "type": "number"
    },
    "task_template_count": {
      "type": "number"
    },
    "dashboard_widget_count": {
      "type": "number"
    },
    "report_count": {
      "type": "number"
    },
    "health_score": {
      "type": "number"
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "pass",
        "warning",
        "fail"
      ]
    },
    "summary": {
      "type": "object"
    },
    "generated_by": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "published_by": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "crm_project_id",
    "version"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
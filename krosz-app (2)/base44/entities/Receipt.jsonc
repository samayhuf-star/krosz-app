{
  "name": "Receipt",
  "type": "object",
  "description": "Worldz Visa (Phase 10): a payment receipt referencing order + payment + invoice (\u00a738). Issued on successful payment. Number generated server-side. Structured record now; PDF rendering deferred. Owner-or-admin read; system create.",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "order_id": {
      "type": "string"
    },
    "payment_id": {
      "type": "string"
    },
    "invoice_id": {
      "type": "string"
    },
    "traveler_id": {
      "type": "string",
      "description": "Denormalized for access checks."
    },
    "receipt_number": {
      "type": "string",
      "description": "Server-generated, e.g. RCT-2026-000123."
    },
    "currency": {
      "type": "string"
    },
    "total_minor": {
      "type": "number"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "order_id",
    "payment_id",
    "traveler_id",
    "receipt_number",
    "currency",
    "total_minor"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
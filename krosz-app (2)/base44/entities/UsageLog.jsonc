{
  "name": "UsageLog",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "operation": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "test_connection",
        "production_operation",
        "failed_operation"
      ],
      "default": "production_operation"
    },
    "usage_quantity": {
      "type": "number"
    },
    "usage_unit": {
      "type": "string"
    },
    "provider_request_id": {
      "type": "string"
    },
    "success": {
      "type": "boolean",
      "default": true
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "provider_id",
    "service",
    "operation",
    "usage_quantity",
    "usage_unit"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
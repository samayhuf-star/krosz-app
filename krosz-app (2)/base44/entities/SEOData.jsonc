{
  "name": "SEOData",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "page_id": {
      "type": "string"
    },
    "seo_title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string"
    },
    "h1": {
      "type": "string"
    },
    "headings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "keywords_topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "canonical_url": {
      "type": "string"
    },
    "schema_data": {
      "type": "object"
    },
    "open_graph": {
      "type": "object"
    },
    "internal_links": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "image_alt_text": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "breadcrumbs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "indexable": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "page_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "chatbot_id": {
      "type": "string",
      "description": "The Chatbot this conversation belongs to (Phase 14)."
    },
    "ai_agent_id": {
      "type": "string",
      "description": "Legacy field; the chatbot's backing AIAgent id."
    },
    "visitor_id": {
      "type": "string",
      "description": "Anonymous session id (widget localStorage). Stable across a browser session."
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "default": "web"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "active",
        "waiting_for_customer",
        "waiting_for_action",
        "waiting_for_approval",
        "escalated",
        "resolved",
        "closed"
      ],
      "default": "new",
      "description": "Conversation state machine (Phase 14)."
    },
    "escalation_state": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "handed_off",
        "resolved"
      ],
      "default": "none"
    },
    "assigned_agent": {
      "type": "string"
    },
    "customer_context": {
      "type": "object",
      "description": "Collected customer details (name, phone, email, intent)."
    },
    "summary": {
      "type": "string"
    },
    "resolution_type": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "ticket_id": {
      "type": "string"
    },
    "current_run_id": {
      "type": "string"
    },
    "last_trace_id": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "default": "en"
    },
    "message_count": {
      "type": "number",
      "default": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "business_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
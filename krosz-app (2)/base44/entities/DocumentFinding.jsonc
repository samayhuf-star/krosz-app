{
  "name": "DocumentFinding",
  "type": "object",
  "description": "Worldz Visa (Phase 5/6): a structured validation finding for a DocumentVersion, optionally scoped to an application. Severity + blocking drive whether the finding blocks requirement satisfaction. Resolved findings stop blocking. Phase 6 adds APPLICATION_DATA_CONFLICT (user override of an extracted value). Owner-of-document-version-or-admin.",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "document_version_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string",
      "description": "Denormalized."
    },
    "intelligence_id": {
      "type": "string"
    },
    "application_id": {
      "type": "string",
      "description": "Present only for route-specific / cross-document / application-data findings tied to a VisaApplication."
    },
    "type": {
      "type": "string",
      "enum": [
        "MISSING_FIELD",
        "INVALID_VALUE",
        "EXPIRED",
        "EXPIRING",
        "TYPE_MISMATCH",
        "OCR_CONFLICT",
        "MRZ_CONFLICT",
        "IDENTITY_MISMATCH",
        "QUALITY_ISSUE",
        "ROUTE_REQUIREMENT_FAILURE",
        "APPLICATION_DATA_CONFLICT"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "default": "MEDIUM"
    },
    "blocking": {
      "type": "boolean",
      "default": false
    },
    "field": {
      "type": "string",
      "description": "Field name the finding concerns, if any."
    },
    "message": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Which validator produced it (mrz, date, field, route, cross_document, application_data...)."
    },
    "resolved": {
      "type": "boolean",
      "default": false
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "document_version_id",
    "type",
    "severity"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
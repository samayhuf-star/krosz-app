{
  "name": "CommunicationLog",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "default": "email"
    },
    "provider_id": {
      "type": "string"
    },
    "mailbox_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "sync",
        "send",
        "receive",
        "ai",
        "audit",
        "provision",
        "dns",
        "security",
        "error",
        "retry"
      ],
      "default": "audit"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "info",
        "warning"
      ],
      "default": "info"
    },
    "latency_ms": {
      "type": "number",
      "default": 0
    },
    "sync_duration_ms": {
      "type": "number",
      "default": 0
    },
    "storage_mb": {
      "type": "number",
      "default": 0
    },
    "messages_processed": {
      "type": "number",
      "default": 0
    },
    "tokens": {
      "type": "number",
      "default": 0
    },
    "ai_cost": {
      "type": "number",
      "default": 0
    },
    "error_message": {
      "type": "string"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "actor": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "channel",
    "kind",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
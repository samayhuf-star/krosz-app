{
  "name": "ComponentInstance",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "tenant_id": {
      "type": "string"
    },
    "business_id": {
      "type": "string"
    },
    "website_id": {
      "type": "string"
    },
    "page_id": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "component_key": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "default": 1
    },
    "visible": {
      "type": "boolean",
      "default": true
    },
    "properties": {
      "type": "object"
    },
    "responsive": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  },
  "required": [
    "tenant_id",
    "business_id",
    "website_id",
    "page_id",
    "component_key",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}